# Build output
/hero
/hero-cloud
bin/
dist/
.build/

# Per-session state (refs.db, scratch) — local only
.hero/sessions/

# SQLite index
index.db
index.db-wal
index.db-shm

# Knowledge graph cache (regenerable from sources of truth + git history)
.hero/graph.db
.hero/graph.db-wal
.hero/graph.db-shm

# Cross-language contract caches (regenerated on every hero invocation
# from core/spec-types/ + domains/<active>/spec-types/)
.hero/cache/
.hero/**/.tracker-evidence/

# Cross-repo call transcripts can contain private sibling-repository details.
# Keep the durable call/result state local; public specs may retain only their
# deliberately authored handoff summaries and interface contracts.
.hero/peer-calls/
.wrangler/

# MCP daemon runtime state (per-process singleton pidfile + debug log) — ephemeral
.hero/mcp-*.pid
.hero/mcp-*.pid.*
.hero/mcp-debug.log

# Python bytecode caches
__pycache__/

# Per-machine NEXT state — auto-rewritten every Stop hook + agent scratch.
# Tracked NEXT.md and .hero/next/<user>.md are project/user-durable;
# anything ending in .local.md is genuinely local and never tracked.
.hero/next/*.local.md

# GoReleaser
__snapshot/

# OS
.DS_Store

# mkdocs build output for the docs surface
web/docs/site/

# Auto-generated code intelligence (re-scan to regenerate)
.hero/knowledge/code/

# Per-machine satellite manifest (which subprojects are symlinked locally)
.hero/satellites.local.json

#claude
.claude/settings.local.json

# E2E smoke-test scratch (cloned target repos + per-run logs)
tmp/

# Per-machine smoke run state (last-run.json is regenerated on every `hero smoke`)
.hero/smoke/

# Install-rendered canonical content + harness symlinks.
# These are generated on every `hero install` from the embedded source
# (which lives at agents/, commands/, skills/, domains/<x>/..., core/...).
# Hero's own repo embeds source for distribution; the canonical .hero/
# tree and the harness symlinks pointing at it are install artifacts,
# not source. Run `make install` (or `hero install project . --target X`)
# after cloning to materialize them.
.hero/agents/
.hero/commands/
.hero/skills/
.hero/install-state.json
.claude/agents
.claude/commands
.claude/skills
.opencode/agents
.opencode/commands
.opencode/skills
.cursor/rules/agents
.cursor/rules/commands
.cursor/rules/skills
.codex/agents
.codex/commands
.codex/skills
# Codex reads repo-scoped skills from .agents/skills/, not .codex/skills/
# (the deprecated path above is only cleaned up, never written). The
# `--target codex` install renders core/ + domains/*/ skills here, plus
# each command as command-<name>/SKILL.md.
.agents/skills

# Local env (direnv) — carries credentials, must not be committed
.envrc
.claude/scheduled_tasks.lock
