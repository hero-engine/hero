{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hero.dev/contracts/attention/v1/mail-envelope.schema.json",
  "title": "MailEnvelope",
  "type": "object",
  "required": ["schema_version", "id", "recipient", "sender", "subject", "body", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "recipient": {"$ref": "#/$defs/project"},
    "sender": {"$ref": "#/$defs/project"},
    "subject": {"type": "string", "maxLength": 200},
    "body": {"type": "string", "x-maxBytes": 65536},
    "created_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true},
    "provenance": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/provenance"}}
  },
  "$defs": {
    "project": {"type": "object", "required": ["peer_id", "display_name"], "properties": {"peer_id": {"type": "string", "minLength": 1}, "registry_slug": {"type": "string"}, "display_name": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "required": ["kind", "source_id"], "properties": {"kind": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "label": {"type": "string"}, "url": {"type": "string"}, "created_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true}}}
  }
}
