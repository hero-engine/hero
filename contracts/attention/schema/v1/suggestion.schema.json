{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hero.dev/contracts/attention/v1/suggestion.schema.json",
  "title": "DeferredWorkSuggestion",
  "type": "object",
  "required": ["schema_version", "id", "project", "title", "prompt", "created_at"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1},
    "project": {"type": "object", "required": ["peer_id", "display_name"], "properties": {"peer_id": {"type": "string", "minLength": 1}, "registry_slug": {"type": "string"}, "display_name": {"type": "string", "minLength": 1}}},
    "title": {"type": "string"}, "prompt": {"type": "string", "x-maxBytes": 65536}, "created_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true},
    "provenance": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["kind", "source_id"], "properties": {"kind": {"type": "string"}, "source_id": {"type": "string"}, "label": {"type": "string"}, "url": {"type": "string"}, "created_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true}}}}
  }
}
