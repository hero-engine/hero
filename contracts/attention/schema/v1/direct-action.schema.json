{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hero.dev/contracts/attention/v1/direct-action.schema.json",
  "title": "DirectActionFixture",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operation_id", "request", "expected_source_kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "operation_id": {"enum": ["mail.send", "mail.reply", "focus.create"]},
          "expected_source_kind": {"enum": ["mail_delivery", "focus_item"]},
          "request": {
            "oneOf": [
              {
                "type": "object",
                "required": ["schema_version", "intent_source", "recipient", "recipient_peer_id", "subject", "body", "idempotency_key"],
                "properties": {
                  "schema_version": {"const": 1},
                  "intent_source": {"const": "user"},
                  "recipient": {"type": "string", "minLength": 1},
                  "recipient_peer_id": {"type": "string", "minLength": 1},
                  "subject": {"type": "string", "minLength": 1, "maxLength": 200},
                  "body": {"type": "string", "x-maxBytes": 65536},
                  "kind": {"type": "string", "maxLength": 64},
                  "source_kind": {"type": "string", "maxLength": 64},
                  "source_id": {"type": "string", "maxLength": 512},
                  "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              },
              {
                "type": "object",
                "required": ["schema_version", "intent_source", "message_id", "thread_id", "body", "idempotency_key"],
                "properties": {
                  "schema_version": {"const": 1},
                  "intent_source": {"const": "user"},
                  "message_id": {"type": "string", "minLength": 1},
                  "thread_id": {"type": "string", "minLength": 1},
                  "subject": {"type": "string", "maxLength": 200},
                  "body": {"type": "string", "minLength": 1, "x-maxBytes": 65536},
                  "kind": {"type": "string", "maxLength": 64},
                  "source_kind": {"type": "string", "maxLength": 64},
                  "source_id": {"type": "string", "maxLength": 512},
                  "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              },
              {
                "type": "object",
                "required": ["schema_version", "intent_source", "title", "prompt", "lifecycle", "source_id", "idempotency_key"],
                "properties": {
                  "schema_version": {"const": 1},
                  "intent_source": {"const": "user"},
                  "title": {"type": "string", "minLength": 1, "maxLength": 200},
                  "prompt": {"type": "string", "minLength": 1, "x-maxBytes": 65536},
                  "lifecycle": {"enum": ["inbox", "today", "later", "done"]},
                  "project": {"type": "string", "minLength": 1},
                  "project_peer_id": {"type": "string", "minLength": 1},
                  "source_id": {"type": "string", "minLength": 1, "maxLength": 512},
                  "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              }
            ]
          }
        }
      }
    }
  }
}
