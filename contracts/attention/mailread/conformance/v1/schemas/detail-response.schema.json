{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hero.dev/contracts/attention/mailread/v1/detail-response.schema.json",
  "title": "MailReadDetailResponse",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"$ref": "#/$defs/project"},
    "envelope": {"$ref": "#/$defs/envelope"},
    "activity_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true},
    "unread": {"type": "boolean"},
    "receipt": {"$ref": "#/$defs/receipt"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
    "error": {"$ref": "#/$defs/error"}
  },
  "anyOf": [
    {"required": ["project", "envelope", "activity_at", "unread", "receipt", "actions"]},
    {"required": ["error"]}
  ],
  "$defs": {
    "project": {
      "type": "object",
      "required": ["peer_id", "display_name"],
      "properties": {"peer_id": {"type": "string", "minLength": 1}, "registry_slug": {"type": "string"}, "display_name": {"type": "string", "minLength": 1}}
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "source_id"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}, "label": {"type": "string"}, "url": {"type": "string"}, "created_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true}}
    },
    "envelope": {
      "type": "object",
      "required": ["schema_version", "id", "recipient", "sender", "subject", "body", "created_at"],
      "properties": {
        "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1},
        "recipient": {"$ref": "#/$defs/project"}, "sender": {"$ref": "#/$defs/project"},
        "subject": {"type": "string", "maxLength": 200}, "body": {"type": "string", "x-maxBytes": 65536},
        "kind": {"type": "string", "maxLength": 64}, "thread_id": {"type": "string", "minLength": 1},
        "in_reply_to": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 0},
        "idempotency_key": {"type": "string", "maxLength": 512},
        "created_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true},
        "provenance": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "artifact": {"type": "object", "required": ["slug", "type", "status"], "properties": {"slug": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "status": {"type": "string"}}},
    "receipt": {
      "type": "object", "required": ["revision", "unread"],
      "properties": {
        "revision": {"type": "integer", "minimum": 0}, "unread": {"type": "boolean"},
        "read_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true},
        "acknowledged_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true},
        "dismissed_at": {"type": "string", "format": "date-time", "x-utcRFC3339Nano": true},
        "promoted_artifact": {"$ref": "#/$defs/artifact"}, "focus_item_id": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object", "required": ["id", "label", "required_row_revision", "requires_idempotency"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "style": {"type": "string"},
        "confirmation": {"type": "string"}, "operation_id": {"type": "string"}, "effect": {"type": "string"}, "consent": {"type": "string"},
        "input_schema": {"type": "object"}, "required_row_revision": {"type": "integer", "minimum": 0}, "requires_idempotency": {"type": "boolean"}
      }
    },
    "error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "field": {"type": "string"}, "details": {"type": "object"}}}
  }
}
