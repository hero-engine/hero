{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hero.dev/contracts/attention/v1/mcp-tool-inventory.schema.json",
  "title": "AttentionMCPToolInventory",
  "type": "object",
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": 1},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema", "annotations", "_meta"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "inputSchema": {"type": "object"},
          "annotations": {"type": "object"},
          "_meta": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
