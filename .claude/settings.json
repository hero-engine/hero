{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "hero next checkpoint --quiet",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "hero next checkpoint --quiet",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(hero:*)"
    ]
  }
}
