    "content": {
      "format": "markdown",
      "body": "- WHEN the export contains a cell with a leading `=`, `+`, `-`, or `@`, THE SYSTEM SHALL prefix the cell with a single quote to neutralize the CSV-injection vector."
    },
    "rationale": "CSV injection is a known shortcut into spreadsheet macro execution.",
    "emitted_at": "2026-05-21T13:00:03Z"
