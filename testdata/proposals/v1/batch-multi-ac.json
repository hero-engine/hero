    "content": {
      "format": "markdown",
      "body": "- THE SYSTEM SHALL escape embedded double quotes by doubling them, per RFC 4180."
    },
    "rationale": "Without RFC 4180 quoting, Excel breaks on any cell containing a quote.",
    "emitted_at": "2026-05-21T13:00:02Z"
  },
